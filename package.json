{
  "name": "omvpraf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:cf && wrangler dev",
    "build": "vite build",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --platform=neutral --target=es2022 --alias:ws=./worker/ws-stub.ts --outfile=dist-worker/worker.js",
    "build:cf": "bun run build && bun run build:worker",
    "deploy": "bun run build:cf && wrangler deploy",
    "db:init": "wrangler d1 execute chartflow --remote --file=./sql/schema.sql",
    "preview:cf": "wrangler dev",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-worker server.js",
    "lint": "tsc --noEmit",
    "dev:node": "tsx server.ts",
    "pages:dev": "bun run build && wrangler pages dev dist --d1 DB",
    "pages:deploy": "bun run build && wrangler pages deploy dist --project-name chartcf"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "wrangler": "^4.42.0"
  }
}
